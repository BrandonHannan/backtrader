{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug (Windows g++)",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/a.exe", 
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}",
        "environment": [],
        "externalConsole": false,
        
        // CHANGED: Use gdb for Windows/MinGW
        "MIMode": "gdb",
        
        // CRITICAL: You must point this to where your gdb.exe is installed.
        // It is usually in the same 'bin' folder as your 'g++'.
        // Update the path below to match your actual installation path.
        "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
        
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            }
        ],
        "preLaunchTask": "Build with Make"
      }
    ]
  }